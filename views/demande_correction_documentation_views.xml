<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List -->
    <record id="view_ar_demande_correction_documentation_list" model="ir.ui.view">
        <field name="name">ar.demande.correction.documentation.list</field>
        <field name="model">ar.demande.correction.documentation</field>
        <field name="arch" type="xml">
            <list>
                <field name="description"/>
                <field name="file_name"/>
                <field name="link_url"/>
                <field name="created_by"/>
                <field name="created_on"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_ar_demande_correction_documentation_form" model="ir.ui.view">
        <field name="name">ar.demande.correction.documentation.form</field>
        <field name="model">ar.demande.correction.documentation</field>
        <field name="arch" type="xml">
            <form string="Documentation - Correction écarts">
                <sheet>
                    <group>
                        <field name="description"/>
                        <field name="file_data" filename="file_name"/>
                        <field name="file_name" invisible="True"/>
                        <field name="link_url" placeholder="https://..."/>
                    </group>

                    <group string="Audit">
                        <field name="created_by" readonly="True"/>
                        <field name="created_on" readonly="True"/>
                    </group>

                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ar_demande_correction_documentation" model="ir.actions.act_window">
        <field name="name">Documentation</field>
        <field name="res_model">ar.demande.correction.documentation</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>