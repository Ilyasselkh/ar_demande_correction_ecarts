<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_ar_demande_correction_list" model="ir.ui.view">
    <field name="name">ar.demande.correction.list</field>
    <field name="model">ar.demande.correction</field>
    <field name="arch" type="xml">
      <list decoration-success="state == 'valide'"
            decoration-danger="state == 'refuse'"
            decoration-info="state in ['n1', 'sup_log', 'msc', 'mfin', 'md', 'v5']"
            decoration-muted="state == 'draft'">
        <field name="name"/>
        <field name="state" widget="badge"
               decoration-success="state == 'valide'"
               decoration-danger="state == 'refuse'"
               decoration-info="state in ['n1', 'sup_log', 'msc', 'mfin', 'md', 'v5']"
               decoration-muted="state == 'draft'"/>
        <field name="ajustement"/>
        <field name="demandeur_id"/>
        <field name="department_id"/>
        <field name="total_mad"/>
        <field name="total_absolu"/>
        <field name="date_demande"/>
      </list>
    </field>
  </record>

  <record id="view_ar_demande_correction_form" model="ir.ui.view">
    <field name="name">ar.demande.correction.form</field>
    <field name="model">ar.demande.correction</field>
    <field name="arch" type="xml">
      <form string="Demande de correction" class="ar_demande_correction_form">
        <header>
          <field name="state" widget="statusbar" statusbar_visible="draft,n1,sup_log,msc,mfin,md,v5,valide,refuse"/>

          <button name="action_soumettre"
                  type="object"
                  string="Soumettre"
                  class="btn-primary"
                  invisible="state != 'draft'"/>

          <button name="action_valider"
                  type="object"
                  string="Valider"
                  class="btn-success"
                  invisible="is_demandeur or state in ['draft', 'valide', 'refuse']"/>

          <button name="action_refuser"
                  type="object"
                  string="Refuser"
                  class="btn-danger"
                  invisible="is_demandeur or state in ['draft', 'valide', 'refuse']"/>
        </header>

        <sheet class="ar_demande_correction_sheet ar_sortie_caisse_sheet" style="max-width: none; width: calc(100% - 32px);">
          <field name="is_demandeur" invisible="True"/>

          <div class="ar_sortie_caisse_title">
            <div>
              <span class="ar_sortie_caisse_label">Demande correction ecarts</span>
              <h1>
                <field name="name" readonly="True" nolabel="1"/>
              </h1>
              <div class="ar_sc_static_3d" aria-hidden="true">
                <span class="ar_sc_3d_card ar_sc_3d_card_main"/>
                <span class="ar_sc_3d_card ar_sc_3d_card_back"/>
                <span class="ar_sc_3d_card ar_sc_3d_card_front"/>
                <span class="ar_sc_3d_coin ar_sc_3d_coin_one"/>
                <span class="ar_sc_3d_coin ar_sc_3d_coin_two"/>
                <span class="ar_sc_3d_coin ar_sc_3d_coin_three"/>
              </div>
            </div>
            <div class="ar_sortie_caisse_amount">
              <span>Valeur demandee</span>
              <field name="total_mad" readonly="True" nolabel="1"/>
              <small>DH</small>
            </div>
          </div>

          <div class="ar_sortie_caisse_main_row ar_dc_equal_sections">
            <group class="ar_sortie_caisse_panel ar_sortie_caisse_identity">
              <group string="Informations demandeur">
                <field name="demandeur_id" readonly="True"/>
                <field name="department_id" readonly="True"/>
                <field name="manager_n1_id" readonly="True"/>
                <field name="date_demande" readonly="True"/>
              </group>
            </group>

            <group class="ar_sortie_caisse_panel ar_sortie_caisse_description ar_dc_context_panel">
              <group string="Contexte de l'ajustement">
                <field name="ajustement"
                       required="True"
                       readonly="state != 'draft'"
                       placeholder="Selectionner un ajustement..."/>
                <field name="inventaire_tournant"
                       invisible="ajustement != 'ecarts'"
                       required="ajustement == 'ecarts'"
                       readonly="state != 'draft'"/>
                <field name="numero_session"
                       invisible="inventaire_tournant != 'oui'"
                       required="inventaire_tournant == 'oui'"
                       readonly="state != 'draft'"/>
                <field name="commentaire"
                       placeholder="Saisir un commentaire"
                       readonly="state in ['valide', 'refuse']"/>
              </group>
            </group>
          </div>

          <div class="ar_dc_state_hint" invisible="state in ['draft', 'valide', 'refuse']">
            Cette demande est en circuit de validation. Les lignes restent consultables, mais ne sont plus modifiables.
          </div>

          <notebook class="ar_dc_full_notebook">
            <page string="Details de l'ecart">
              <field name="line_ids"
                     nolabel="1"
                     colspan="4"
                     readonly="state != 'draft'">
                <list editable="bottom" delete="1">
                  <field name="magasin" string="Magasin" required="1"/>
                  <field name="reference" string="Ref." required="1"/>
                  <field name="designation" string="Designation" required="1"/>
                  <field name="lot" string="Lot" required="1"/>
                  <field name="quantite" string="Qte" required="1"/>
                  <field name="unite" string="Unite" required="1"/>
                  <field name="valeur_mad" string="Valeur MAD" required="1"/>
                  <field name="motif_ecart" string="Motif" required="1"/>
                </list>
              </field>

              <group class="ar_dc_totals" string="Synthese financiere">
                <field name="total_mad" readonly="True"/>
                <field name="total_absolu" readonly="True"/>
              </group>
            </page>

            <page string="Validation">
              <group class="ar_dc_validation_grid">
                <field name="regle_id" readonly="True"/>
                <field name="validateur1_id" readonly="True"/>
                <field name="validateur2_id" readonly="True"/>
                <field name="validateur3_id" readonly="True"/>
                <field name="validateur4_id" readonly="True"/>
                <field name="validateur5_id" readonly="True"/>
                <field name="current_level" readonly="True"/>
              </group>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_ar_demande_correction" model="ir.actions.act_window">
    <field name="name">Demande de correction</field>
    <field name="res_model">ar.demande.correction</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('state','not in',('valide','refuse'))]</field>
  </record>

  <record id="action_ar_archives_validees" model="ir.actions.act_window">
    <field name="name">Archives - Validees</field>
    <field name="res_model">ar.demande.correction</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('state','=','valide')]</field>
  </record>

  <record id="action_ar_archives_refusees" model="ir.actions.act_window">
    <field name="name">Archives - Refusees</field>
    <field name="res_model">ar.demande.correction</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('state','=','refuse')]</field>
  </record>

</odoo>
