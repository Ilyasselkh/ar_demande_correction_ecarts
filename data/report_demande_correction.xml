<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="rep_demande_correction_ecarts">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-call="ar_demande_correction_ecarts.report_demande_correction_araymond_external_layout">
                    <div class="page">
                        <style>
                            .ar_report_title {
                                color: #0f172a;
                                font-size: 24px;
                                font-weight: 800;
                                margin-bottom: 18px;
                                text-align: center;
                                text-transform: uppercase;
                            }
                            .ar_report_ref {
                                background: #eef8f6;
                                border: 1px solid #9ed3cd;
                                border-radius: 6px;
                                color: #115e59;
                                display: inline-block;
                                font-weight: 800;
                                margin-bottom: 18px;
                                padding: 7px 12px;
                                white-space: nowrap;
                            }
                            .ar_report_section {
                                border: 1px solid #d8e0ea;
                                border-radius: 6px;
                                margin-bottom: 16px;
                                padding: 14px 16px;
                            }
                            .ar_report_section h3 {
                                border-bottom: 1px solid #e7edf4;
                                color: #172033;
                                font-size: 14px;
                                font-weight: 800;
                                margin: 0 0 12px;
                                padding-bottom: 8px;
                                text-transform: uppercase;
                            }
                            .ar_report_grid {
                                display: table;
                                width: 100%;
                            }
                            .ar_report_row {
                                display: table-row;
                            }
                            .ar_report_label,
                            .ar_report_value {
                                display: table-cell;
                                padding: 5px 0;
                                vertical-align: top;
                            }
                            .ar_report_label {
                                color: #697386;
                                font-weight: 700;
                                width: 170px;
                            }
                            .ar_report_table {
                                border-collapse: collapse;
                                width: 100%;
                            }
                            .ar_report_table th {
                                background: #eef3f8;
                                border: 1px solid #cfdce8;
                                color: #172033;
                                font-weight: 800;
                                padding: 8px;
                                text-align: left;
                            }
                            .ar_report_table td {
                                border: 1px solid #d8e0ea;
                                padding: 8px;
                                vertical-align: top;
                            }
                            .ar_report_num {
                                text-align: right;
                                white-space: nowrap;
                            }
                            .ar_report_center {
                                text-align: center;
                            }
                            .ar_report_total {
                                background: #eef8f6;
                                border: 1px solid #9ed3cd;
                                border-radius: 6px;
                                color: #115e59;
                                font-size: 15px;
                                font-weight: 900;
                                margin-top: 12px;
                                padding: 10px 12px;
                                text-align: right;
                            }
                            .ar_report_status {
                                border-radius: 999px;
                                display: inline-block;
                                font-size: 11px;
                                font-weight: 800;
                                padding: 4px 9px;
                                white-space: nowrap;
                            }
                            .ar_report_status_done {
                                background: #eaf7ef;
                                color: #166534;
                            }
                            .ar_report_status_current {
                                background: #eef3ff;
                                color: #1d4ed8;
                            }
                            .ar_report_status_pending {
                                background: #f8fafc;
                                color: #64748b;
                            }
                            .ar_report_status_refused {
                                background: #fef2f2;
                                color: #b91c1c;
                            }
                            .ar_report_status_not_required {
                                background: #f3f4f6;
                                color: #6b7280;
                            }
                        </style>

                        <h1 class="ar_report_title">DEMANDE D'AJUSTEMENT DE STOCK</h1>
                        <div class="ar_report_ref">
                            Référence :
                            <span t-field="doc.name"/>
                        </div>

                        <div class="ar_report_section">
                            <h3>Informations demandeur</h3>
                            <div class="ar_report_grid">
                                <div class="ar_report_row">
                                    <div class="ar_report_label">Demandeur</div>
                                    <div class="ar_report_value"><span t-field="doc.demandeur_id"/></div>
                                </div>
                                <div class="ar_report_row">
                                    <div class="ar_report_label">Manager N+1</div>
                                    <div class="ar_report_value"><span t-field="doc.manager_n1_id"/></div>
                                </div>
                                <div class="ar_report_row">
                                    <div class="ar_report_label">Département</div>
                                    <div class="ar_report_value"><span t-field="doc.department_id"/></div>
                                </div>
                                <div class="ar_report_row">
                                    <div class="ar_report_label">Date</div>
                                    <div class="ar_report_value"><span t-field="doc.date_demande"/></div>
                                </div>
                                <div class="ar_report_row">
                                    <div class="ar_report_label">État</div>
                                    <div class="ar_report_value"><span t-field="doc.state"/></div>
                                </div>
                            </div>
                        </div>

                        <div class="ar_report_section">
                            <h3>Contexte de l'ajustement</h3>
                            <div class="ar_report_grid">
                                <div class="ar_report_row">
                                    <div class="ar_report_label">Ajustement de Stock</div>
                                    <div class="ar_report_value"><span t-field="doc.ajustement"/></div>
                                </div>
                                <div class="ar_report_row" t-if="doc.ajustement == 'ecarts'">
                                    <div class="ar_report_label">Inventaire tournant</div>
                                    <div class="ar_report_value"><span t-field="doc.inventaire_tournant"/></div>
                                </div>
                                <div class="ar_report_row" t-if="doc.inventaire_tournant == 'oui'">
                                    <div class="ar_report_label">Numéro de session</div>
                                    <div class="ar_report_value">
                                        <span t-if="doc.numero_session" t-field="doc.numero_session"/>
                                        <span t-else="">-</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="ar_report_section">
                            <h3>Commentaire général</h3>
                            <div t-if="doc.commentaire">
                                <span t-field="doc.commentaire"/>
                            </div>
                            <div t-else="">-</div>
                        </div>

                        <div class="ar_report_section">
                            <h3>Détails de l'écart</h3>
                            <table class="ar_report_table">
                                <thead>
                                    <tr>
                                        <th>Magasin</th>
                                        <th>Référence</th>
                                        <th>Désignation</th>
                                        <th>Lot</th>
                                        <th class="ar_report_num">Quantité</th>
                                        <th>Unité</th>
                                        <th class="ar_report_num">Valeur MAD</th>
                                        <th>Motif écart</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.line_ids" t-as="line">
                                        <td><span t-field="line.magasin"/></td>
                                        <td><span t-field="line.reference"/></td>
                                        <td><span t-field="line.designation"/></td>
                                        <td><span t-field="line.lot"/></td>
                                        <td class="ar_report_num"><span t-field="line.quantite"/></td>
                                        <td><span t-field="line.unite"/></td>
                                        <td class="ar_report_num">
                                            <span t-esc="'%s DH' % ('{:,.2f}'.format(line.valeur_mad or 0.0).replace(',', ' ').replace('.', ','))"/>
                                        </td>
                                        <td><span t-field="line.motif_ecart"/></td>
                                    </tr>
                                    <tr t-if="not doc.line_ids">
                                        <td colspan="8">Aucune ligne.</td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="ar_report_total">
                                Total :
                                <span t-esc="'%s DH' % ('{:,.2f}'.format(doc.total_mad or 0.0).replace(',', ' ').replace('.', ','))"/>
                            </div>
                        </div>

                        <div class="ar_report_section">
                            <h3>Synthèse financière</h3>
                            <div class="ar_report_grid">
                                <div class="ar_report_row">
                                    <div class="ar_report_label">Total Valeur (MAD)</div>
                                    <div class="ar_report_value">
                                        <span t-esc="'%s DH' % ('{:,.2f}'.format(doc.total_mad or 0.0).replace(',', ' ').replace('.', ','))"/>
                                    </div>
                                </div>
                                <div class="ar_report_row">
                                    <div class="ar_report_label">Total absolu</div>
                                    <div class="ar_report_value">
                                        <span t-esc="'%s DH' % ('{:,.2f}'.format(doc.total_absolu or 0.0).replace(',', ' ').replace('.', ','))"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="ar_report_section">
                            <h3>Historique des validations</h3>
                            <table class="ar_report_table">
                                <thead>
                                    <tr>
                                        <th>Signataire</th>
                                        <th>Étape</th>
                                        <th class="ar_report_center">Statut</th>
                                        <th>Date validation</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.get_report_validation_history()" t-as="step">
                                        <td>
                                            <span t-if="step['user']" t-esc="step['user'].name"/>
                                            <span t-else="">-</span>
                                        </td>
                                        <td><span t-esc="step['label']"/></td>
                                        <td class="ar_report_center">
                                            <span t-attf-class="ar_report_status ar_report_status_#{step['status_key']}">
                                                <span t-esc="step['status']"/>
                                            </span>
                                        </td>
                                        <td>
                                            <span t-esc="step['date']"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_demande_correction_ecarts" model="ir.actions.report">
        <field name="name">Demande Ajustement De Stock</field>
        <field name="model">ar.demande.correction</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ar_demande_correction_ecarts.rep_demande_correction_ecarts</field>
        <field name="report_file">ar_demande_correction_ecarts.rep_demande_correction_ecarts</field>
        <field name="paperformat_id" ref="ar_demande_correction_ecarts.paperformat_demande_correction_araymond"/>
        <field name="print_report_name">'Demande_Correction_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_ar_demande_correction"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
